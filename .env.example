# ==============================================================================
# Sing Sing Restaurant OS (Freehouse Collective) - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development in VS Code:
#   cp .env.example .env.local
#
# Replace the placeholder values with your actual keys.
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Used for the Phase 1 AI Voice Concierge Live WebSocket (Gemini Multimodal Live API)
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Application Host URL (defaults to http://localhost:3000 in dev)
APP_URL=http://localhost:3000

# [OPTIONAL] Server Port (defaults to 3000)
PORT=3000
